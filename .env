# Server port (default: 4800)
AUTOMD_PORT=4800

# Frontend: server URL for API and WebSocket connections
VITE_AUTOMD_SERVER=http://localhost:4800

# Disable authentication (for development only)
AUTOMD_DISABLE_AUTH=false

# Disable automatic update checking (default: false)
# AUTOMD_DISABLE_UPDATE_CHECK=true

# Update check interval in milliseconds (default: 21600000 = 6 hours)
# AUTOMD_UPDATE_CHECK_INTERVAL=21600000

# S3 backup sync (optional — bucket + access key required to enable)
# Supports AWS S3, Cloudflare R2, MinIO, or any S3-compatible provider.
# AUTOMD_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AUTOMD_S3_BUCKET=automd-backups
# AUTOMD_S3_ACCESS_KEY_ID=
# AUTOMD_S3_SECRET_ACCESS_KEY=
# AUTOMD_S3_PREFIX=               # optional namespace prefix for multi-tenant
